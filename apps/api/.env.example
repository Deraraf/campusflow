# Server Configuration
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/campusflow?sslmode=disable

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Mail / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password
MAIL_FROM="CampusFlow <noreply@campusflow.edu>"

# Optional overrides
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email

# Set only to trusted reverse-proxy IPs/CIDRs that forward X-Forwarded-For.
# TRUSTED_PROXY_IPS=10.0.0.0/8
